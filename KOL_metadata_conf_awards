def store_kol_details(kol_metadata):
    """Store KOL details in OpenSearch."""
    try:
        opensearch.index(index="kol_details_staging", body=kol_metadata)
        return True
    except Exception as e:
        print(f"Error storing KOL details: {str(e)}")
        return False

def get_conferences_and_awards(kol_name, url):
    prompt = f"""
    Your task is to find major conferences and awards associated with this medical professional:
    Name: {kol_name}
    Link: {url}

    Use credible sources like OncLive, aacr.org, etc. Mention conference names, article/page title, date (if available), and a valid source URL.

    Output format: An array of strings like:
    [
        "Title, Date (if available), Source URL"
    ]
    """
    try:
        response = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[
                {"role": "system", "content": "You are a medical metadata enrichment expert."},
                {"role": "user", "content": prompt}
            ],
            temperature=0.7,
            max_tokens=1000
        )
        raw_text = response.choices[0].message.content
        clean_json = raw_text.replace('```json', '').replace('```', '').strip()
        return json.loads(clean_json)
    except Exception as e:
        print(f"Error getting conferences for {kol_name}: {e}")
        return []



def fetch_authors_from_opensearch():
    """Fetch top authors from OpenSearch article_index."""
    query = {
        "size": 0,
        "query": {
            "term": {
                "article_category": "NF AND Advocacy Groups"
            }
        },
        "aggs": {
            "top_authors": {
                "terms": {
                    "script": {
                        "source": "params['_source']['authors']",
                        "lang": "painless"
                    },
                    "size": 15,
                    "order": {"_count": "desc"}
                }
            }
        }
    }
   
    try:
        response = opensearch.search(index="articles_index", body=query)
        buckets = response["aggregations"]["top_authors"]["buckets"]
        authors_list = [bucket["key"] for bucket in buckets]
        print(f"Fetched {len(authors_list)} authors from OpenSearch: {authors_list}")
        return authors_list
    except Exception as e:
        print(f"Error fetching authors from OpenSearch: {str(e)}")
        return []
# Lambda Handler
def lambda_handler(event, context):
    # Fetch authors dynamically from OpenSearch
    authors_list = fetch_authors_from_opensearch()
    if not authors_list:
        return {
            "statusCode": 500,
            "body": json.dumps({"error": "Failed to fetch authors from OpenSearch"})
        }
   
    with ThreadPoolExecutor(max_workers=2) as executor:
        results = []
        for future in executor.map(process_kol, authors_list):
            results.extend(future)
            time.sleep(0.5)
    return {
        "statusCode": 200,
        "body": json.dumps(results, indent=2)
    }
