# Function to fetch research details from PubMed
def clean_affiliation(affiliation: str) -> str:
    """Remove emails, phone numbers, and extraneous details from affiliation."""
    if not affiliation:
        return "N/A"
    # Remove emails, "Electronic address", and phone numbers (e.g., "1 5166001421", "+1-123-456-7890")
    cleaned = re.sub(r'(\S+@\S+\.\S+|Electronic address:\s*\S+|\+?\d[\d\s-]{7,})', '', affiliation).strip()
    # Remove trailing period and normalize spaces
    cleaned = re.sub(r'\s+', ' ', cleaned).rstrip('.')
    return cleaned
 
def parse_location_from_affiliation(affiliation: str) -> str:
    """Parse location (state/province, country or state or country) from affiliation."""
    if not affiliation or affiliation.lower() == "n/a":
        return "N/A"
   
    # Clean the affiliation
    cleaned_aff = clean_affiliation(affiliation)
    # Split by commas, filter out empty or numeric parts (postal codes)
    parts = [part.strip() for part in cleaned_aff.split(',') if part.strip() and not part.strip().isdigit()]
    if not parts:
        return "N/A"
   
    # Work backward to identify state/province and country
    if len(parts) >= 2:
        last_part = parts[-1].strip()
        second_last = parts[-2].strip()
        # Check if second-to-last looks like a state/province (short code or single word)
        if (len(second_last) <= 3 and second_last.isalpha()) or (len(second_last.split()) == 1 and second_last.lower() not in {'university', 'hospital', 'institute', 'research', 'health', 'drive', 'suite'}):
            return f"{second_last}, {last_part}"
        # If no clear state/province, use the last part (country)
        return last_part
    # Only one part: could be state or country
    return parts[-1].strip()
 
def fetch_pubmed_details(pubmed_ids: List[str], target_author: str) -> Dict[str, any]:
    """
    Fetch research details from PubMed and extract affiliations for target author and co-authors.
    Excludes the target author (main KOL) from collaborators.
 
    Args:
        pubmed_ids (list): List of PubMed IDs to fetch
        target_author (str): Full name of target author (First Middle Last or First Last)
 
    Returns:
        dict: Dictionary containing research details, collaborators (excluding target author),
              primary affiliation, geographical influence (co-authors' details), country, and state/province
    """
    if not pubmed_ids:
        return {
            "research": [],
            "collaborators": [],
            "primary_affiliation": "N/A",
            "geographical_influence": [],
            "country": "N/A",
            "state_province": "N/A"
        }
 
    # Normalize target author name for matching
    target_author_normalized = target_author.lower().replace(" ", "")
   
    research_list = []
    all_collaborators = set()  # Only for co-authors, not target author
    primary_affiliation = "N/A"
    country = "N/A"
    state_province = "N/A"
    geographical_influence = []
    seen_authors = set()  # For deduplication in geographical_influence
   
    # Hardcoded U.S. state lookup dictionary (name: abbreviation)
    us_states = {
        "alabama": "AL", "alaska": "AK", "arizona": "AZ", "arkansas": "AR", "california": "CA",
        "colorado": "CO", "connecticut": "CT", "delaware": "DE", "florida": "FL", "georgia": "GA",
        "hawaii": "HI", "idaho": "ID", "illinois": "IL", "indiana": "IN", "iowa": "IA",
        "kansas": "KS", "kentucky": "KY", "louisiana": "LA", "maine": "ME", "maryland": "MD",
        "massachusetts": "MA", "michigan": "MI", "minnesota": "MN", "mississippi": "MS",
        "missouri": "MO", "montana": "MT", "nebraska": "NE", "nevada": "NV", "new hampshire": "NH",
        "new jersey": "NJ", "new mexico": "NM", "new york": "NY", "north carolina": "NC",
        "north dakota": "ND", "ohio": "OH", "oklahoma": "OK", "oregon": "OR", "pennsylvania": "PA",
        "rhode island": "RI", "south carolina": "SC", "south dakota": "SD", "tennessee": "TN",
        "texas": "TX", "utah": "UT", "vermont": "VT", "virginia": "VA", "washington": "WA",
        "west virginia": "WV", "wisconsin": "WI", "wyoming": "WY"
    }
    us_states_full = {state.lower(): abbr for state, abbr in us_states.items()}
    us_states_abbr = {abbr.lower(): abbr for abbr in us_states.values()}
   
    for pubmed_id in pubmed_ids:
        url = f"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id={pubmed_id}"
       
        try:
            time.sleep(0.5)
            response = requests.get(url, timeout=10)
            response.raise_for_status()
           
            if response.status_code != 200:
                print(f"Failed to fetch data for PubMed ID {pubmed_id}: Status code {response.status_code}")
                continue
           
            root = ET.fromstring(response.text)
           
            # Extract Title and Year for research
            title_element = root.find(".//ArticleTitle")
            title = title_element.text if title_element is not None else "N/A"
            year_element = root.find(".//PubDate/Year")
            year = year_element.text if year_element is not None else "N/A"
            if title != "N/A":
                research_list.append(f"{title} --{year}")
           
            # Extract Authors and Affiliations
            author_list = root.findall(".//Author")
            for author in author_list:
                last_name = author.find("LastName")
                fore_name = author.find("ForeName")
               
                if last_name is None or fore_name is None:
                    full_name = "N/A"
                else:
                    full_name = f"{fore_name.text} {last_name.text}"
                    xml_name_normalized = (fore_name.text.lower() + last_name.text.lower()).replace(" ", "")
               
                is_target_author = xml_name_normalized == target_author_normalized
               
                # Only add to collaborators if NOT the target author
                if not is_target_author and full_name != "N/A":
                    all_collaborators.add(full_name)
               
                affiliation_elements = author.findall(".//Affiliation")
                author_affiliations = [aff.text for aff in affiliation_elements if aff.text]
               
                # Set primary_affiliation, country, and state/province for target author
                if primary_affiliation == "N/A" and is_target_author and author_affiliations:
                    primary_affiliation = author_affiliations[0]
                    aff_cleaned = clean_affiliation(primary_affiliation)
                    location = parse_location_from_affiliation(aff_cleaned)
                    loc_parts = [part.strip().lower() for part in location.split(",") if part.strip()]
                   
                    if len(loc_parts) == 2:
                        second_last_part, last_part = loc_parts
                        if last_part in us_states_abbr:
                            state_province = us_states_abbr[last_part]
                            country = "US"
                        elif last_part in us_states_full:
                            state_province = us_states_full[last_part]
                            country = "US"
                        elif last_part in {"usa", "united states"}:
                            country = "US"
                            if second_last_part in us_states_abbr:
                                state_province = us_states_abbr[second_last_part]
                            elif second_last_part in us_states_full:
                                state_province = us_states_full[second_last_part]
                        elif last_part in {"china", "people's republic of china"}:
                            country = "CN"
                            state_province = second_last_part if second_last_part else "N/A"
                        else:
                            country = last_part.capitalize()
                            state_province = second_last_part if second_last_part in us_states_abbr else "N/A"
                    elif len(loc_parts) == 1:
                        last_part = loc_parts[0]
                        if last_part in us_states_full:
                            state_province = us_states_full[last_part]
                            country = "US"
                        elif last_part in {"usa", "united states"}:
                            country = "US"
                        else:
                            country = last_part.capitalize()
               
                # Build geographical_influence for co-authors (excluding target author)
                if not is_target_author and full_name != "N/A" and full_name not in seen_authors and author_affiliations:
                    seen_authors.add(full_name)
                    affiliation = author_affiliations[0]
                    cleaned_aff = clean_affiliation(affiliation)
                    location = parse_location_from_affiliation(cleaned_aff)
                    entry = {
                        "name": full_name,
                        "affiliation": cleaned_aff,
                        "location": location
                    }
                    geographical_influence.append(json.dumps(entry))
           
        except requests.RequestException as e:
            print(f"Request error for PubMed ID {pubmed_id}: {str(e)}")
            continue
        except ET.ParseError as e:
            print(f"XML parsing error for PubMed ID {pubmed_id}: {str(e)}")
            continue
        except Exception as e:
            print(f"Unexpected error for PubMed ID {pubmed_id}: {str(e)}")
            continue
   
    return {
        "research": research_list,
        "collaborators": list(all_collaborators),
        "primary_affiliation": primary_affiliation,
        "geographical_influence": geographical_influence,
        "country": country,
        "state_province": state_province
    }
 
def fetch_pubmed_data(kol_name: str) -> Dict[str, any]:
    """  
    Args:
        kol_name (str): Full name of KOL (First Middle Last or First Last)
   
    Returns:
        dict: Processed research data with consistent primary affiliation
    """
    search_url = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
   
    name_parts = kol_name.split()
    if len(name_parts) < 2:
        return {"research": [], "collaborators": [], "geographical_influence": [], "primary_affiliation": "N/A", "country": "N/A", "state_province": "N/A"}
   
    first_name = name_parts[0]
    last_name = name_parts[-1]
    middle_initial = name_parts[1][0] if len(name_parts) > 2 else ""
   
    # First try with full name as provided (e.g., "Pashtoon Murtaza Kasi [Author]")
    full_name_search = f"{kol_name}[Author]"
    search_params = {
        "db": "pubmed",
        "term": full_name_search,
        "retmode": "json",
        "retmax": 4
    }
   
    try:
        # First attempt with full name
        response = requests.get(search_url, params=search_params, timeout=30)
        response.raise_for_status()
        data = response.json()
        pubmed_ids = data.get("esearchresult", {}).get("idlist", [])
       
        # If no IDs found, try naming convention (e.g., "Pashtoon M Kasi [Author]")
        if not pubmed_ids and len(name_parts) >= 3:  # Only if there's a middle name to work with
            formatted_name_search = f"{first_name} {middle_initial} {last_name}[Author]"
            search_params["term"] = formatted_name_search
            response = requests.get(search_url, params=search_params, timeout=30)
            response.raise_for_status()
            data = response.json()
            pubmed_ids = data.get("esearchresult", {}).get("idlist", [])
       
        if not pubmed_ids:
            return {"research": [], "collaborators": [], "geographical_influence": [], "primary_affiliation": "N/A", "country": "N/A", "state_province": "N/A"}
       
        pubmed_data = fetch_pubmed_details(pubmed_ids, kol_name)
       
        if not pubmed_data["research"]:
            return {"research": [], "collaborators": [], "geographical_influence": [], "primary_affiliation": "N/A", "country": "N/A", "state_province": "N/A"}
       
        return pubmed_data
   
    except requests.RequestException as e:
        print(f"Request error in esearch: {str(e)}")
        return {"research": [], "collaborators": [], "geographical_influence": [], "primary_affiliation": "N/A", "country": "N/A", "state_province": "N/A"}
    except Exception as e:
        print(f"Unexpected error in esearch: {str(e)}")
        return {"research": [], "collaborators": [], "geographical_influence": [], "primary_affiliation": "N/A", "country": "N/A", "state_province": "N/A"}
